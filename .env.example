# ========================================================
# SAME WEB, DIFFERENT EYES - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
#
# NOTE: Same Web, Different Eyes operates 100% LOCALLY by default.
# NO API KEYS OR CLOUD ACCOUNTS ARE REQUIRED FOR FULL FUNCTIONALITY.
#
# By default, the extension uses:
# - Local Deterministic Fallback Engine (offline rule-based algorithms)
# - Local Ollama REST inference at http://localhost:11434 (offline local models)
# - Local Canvas 2D OCR & Image Understanding (client-side in browser)
# - Local DOM Translation Engine for 7 Indian Languages (offline dictionaries)
# - Client-Side AES-GCM 256-bit Encrypted Personal Vault
#
# If you wish to optionally connect third-party cloud AI providers,
# configure your API keys in the extension Options Dashboard or below:

# Local Ollama Inference Server (Optional - default is http://localhost:11434)
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_OLLAMA_MODEL=llama3

# Optional Cloud AI Providers (All disabled by default)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
VITE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
VITE_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
VITE_GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
